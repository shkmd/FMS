# ---- Shared / infra ----
NODE_ENV=development

# ---- Postgres (apps/api) ----
# Mapped to host port 55432 (not 5432) because a native Windows Postgres service already owns 5432 here.
DATABASE_URL="postgresql://fms:fms_dev_password@127.0.0.1:55432/fms?schema=public"
TEST_DATABASE_URL="postgresql://fms:fms_dev_password@127.0.0.1:55432/fms_test?schema=public"

# ---- Redis (apps/api) ----
REDIS_URL="redis://127.0.0.1:6379"

# ---- Auth (apps/api) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- Object storage / MinIO (apps/api) ----
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="fms_minio"
S3_SECRET_KEY="fms_minio_password"
S3_BUCKET="fms-media"
S3_FORCE_PATH_STYLE="true"

# ---- API server ----
API_PORT=4000
API_CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
