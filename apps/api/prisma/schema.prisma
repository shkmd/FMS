  rejected           Boolean  @default(false)
  quarantined        Boolean  @default(false)

  nurseryBatches NurseryBatch[]

  createdAt DateTime @default(now())
}

enum NurseryStage {
  SEED_TRAY
  SMALL_GROW_BAG
  LARGE_GROW_BAG
  RAIN_SHELTER
  READY_FOR_FIELD
}

model NurseryBatch {
  id                 String            @id @default(uuid())
  farmId             String
  seedLotId          String?
  seedLot            SeedLot?          @relation(fields: [seedLotId], references: [id])
  germinationTrialId String?
  germinationTrial   GerminationTrial? @relation(fields: [germinationTrialId], references: [id])
  cropId             String
  varietyId          String
  variety            CropVariety       @relation(fields: [varietyId], references: [id])
  stage              NurseryStage      @default(SEED_TRAY)
  quantity           Int
  startDate          DateTime          @default(now())
  expectedReadyDate  DateTime?
  currentLocation    String?
  movedToCropCycleId String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedById String?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

// =========================================================================
// Soil & plant health
// =========================================================================

model SoilTest {
