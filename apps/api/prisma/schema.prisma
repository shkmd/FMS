  storageReadings   SeedStorageReading[]
  germinationTrials GerminationTrial[]
  nurseryBatches    NurseryBatch[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedById String?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model SeedStorageReading {
