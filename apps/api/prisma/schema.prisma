}

// =========================================================================
// Inventory, stores, procurement
// =========================================================================

enum InventoryCategory {
  SEEDS
  ORGANIC_INPUTS
  MANURE
  CATTLE_FEED
  POULTRY_FEED
  PET_FOOD
  TOOLS
  SPARE_PARTS
  PACKAGING
  KITCHEN_SUPPLIES
  HARVESTED_PRODUCE
  VALUE_ADDED_PRODUCTS
  CLEANING_MATERIALS
  OTHER_CONSUMABLES
}

model StockLocation {
  id         String    @id @default(uuid())
  farmAreaId String?
  farmArea   FarmArea? @relation(fields: [farmAreaId], references: [id])
  name       String
  type       String?
  capacity   Float?

  createdAt DateTime @default(now())
}

model InventoryItem {
  id            String            @id @default(uuid())
  farmId        String
  name          String
  category      InventoryCategory
  unit          String
  minStockLevel Float?
  trackBatches  Boolean           @default(true)
  description   String?

  batches InventoryBatch[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model InventoryBatch {
  id                String        @id @default(uuid())
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id])
  batchNumber       String?
  quantity          Float
  unit              String
  expiryDate        DateTime?
  storageLocationId String?
  receivedDate      DateTime?
  costPerUnit       Decimal?      @db.Decimal(12, 2)
  status            String        @default("active")

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StockMovementType {
  PURCHASE_RECEIPT
  INTERNAL_PRODUCTION
  ISSUE_TO_TASK
  TRANSFER
  RETURN
  CONSUMPTION
  DAMAGE
  SPOILAGE
  EXPIRY
  ADJUSTMENT
  DISPATCH
}

model StockMovement {
  id                String            @id @default(uuid())
  farmId            String
  itemId            String
  batchId           String?
  batch             InventoryBatch?   @relation(fields: [batchId], references: [id])
  fromLocationId    String?
  toLocationId      String?
  quantity          Float
  unit              String
  movementType      StockMovementType
  requestedById     String?
  issuedById        String?
  receivedById      String?
  occurredAt        DateTime          @default(now())
  relatedTaskId     String?
  attachmentMediaId String?
  reason            String?
  approvedById      String?

  createdAt DateTime @default(now())
}

model StockCount {
  id            String   @id @default(uuid())
  locationId    String
  countDate     DateTime @default(now())
  countedById   String
  varianceNotes String?
  status        String   @default("draft")

  lines StockCountLine[]

  createdAt DateTime @default(now())
}

model StockCountLine {
  id           String     @id @default(uuid())
  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  itemId       String
  systemQty    Float
  countedQty   Float
  varianceQty  Float
}

model Vendor {
  id            String  @id @default(uuid())
  farmId        String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  category      String?
  gstin         String?
  status        String  @default("active")

  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequisition {
  id            String    @id @default(uuid())
  farmId        String
  requestedById String
  farmAreaId    String?
  neededBy      DateTime?
  status        String    @default("draft")
  approvedById  String?

  lines          PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseRequisitionLine {
  id            String              @id @default(uuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  itemId        String
  quantity      Float
  unit          String
  notes         String?
}

model PurchaseOrder {
  id                   String               @id @default(uuid())
  farmId               String
  requisitionId        String?
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  vendorId             String
  vendor               Vendor               @relation(fields: [vendorId], references: [id])
  poNumber             String               @unique
  totalAmount          Decimal?             @db.Decimal(12, 2)
  status               String               @default("draft")
  orderedById          String
  expectedDeliveryDate DateTime?

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  quantity        Float
  unit            String
  unitPrice       Decimal       @db.Decimal(12, 2)
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String
  receivedDate    DateTime      @default(now())
  invoiceRef      String?
  status          String        @default("received")

  lines GoodsReceiptLine[]

  createdAt DateTime @default(now())
}

model GoodsReceiptLine {
  id               String       @id @default(uuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  itemId           String
  quantityReceived Float
  unit             String
  batchNumber      String?
}

// =========================================================================
// Machinery, vehicles, maintenance
// =========================================================================

enum AssetType {
  TRACTOR
  GRASS_CUTTER
  TROLLEY_CUTTER
  SPRAYER
  PUMP
  PROCESSING_EQUIPMENT
  REFRIGERATOR
  COLD_STORAGE
  DAIRY_EQUIPMENT
  VEHICLE
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_USE
  UNDER_REPAIR
  AWAITING_PARTS
  RETIRED
}

model Asset {
  id                   String      @id @default(uuid())
  farmId               String
  assetCode            String      @unique
  name                 String
  type                 AssetType
  purchaseDate         DateTime?
  purchaseCost         Decimal?    @db.Decimal(12, 2)
  currentLocationId    String?
  assignedToId         String?
  operationalStatus    AssetStatus @default(AVAILABLE)
  meterHours           Float?      @default(0)
  serviceIntervalHours Float?
  warrantyExpiry       DateTime?
  documentMediaIds     String[]

  usageLogs           MachineryUsage[]
  maintenanceRequests MaintenanceRequest[]
  maintenanceRecords  MaintenanceRecord[]
  taskLinks           TaskMachinery[]

  createdById String?
  createdAt   DateTime  @default(now())
  updatedById String?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model MachineryUsage {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  taskId     String?
  operatorId String
  date       DateTime @default(now())
  hoursUsed  Float
  meterStart Float?
  meterEnd   Float?
  fuelUsed   Float?
  notes      String?

  createdAt DateTime @default(now())
}

model MaintenanceRequest {
  id               String       @id @default(uuid())
  assetId          String
  asset            Asset        @relation(fields: [assetId], references: [id])
  reportedById     String
  issueDescription String
  priority         TaskPriority @default(MEDIUM)
  status           String       @default("open")
  reportedAt       DateTime     @default(now())

  records MaintenanceRecord[]
}

model MaintenanceRecord {
  id                   String              @id @default(uuid())
  assetId              String
  asset                Asset               @relation(fields: [assetId], references: [id])
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id])
  date                 DateTime            @default(now())
  type                 String // preventive | breakdown
  description          String?
  cost                 Decimal?            @db.Decimal(12, 2)
  partsUsedJson        Json?
  performedById        String?
  downtimeHours        Float?

  createdAt DateTime @default(now())
}

