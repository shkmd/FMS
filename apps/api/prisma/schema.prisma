model RAndDTrial {
  id                  String            @id @default(uuid())
  farmId              String
  trialCode           String            @unique
  objective           String
  cropId              String
  crop                Crop              @relation(fields: [cropId], references: [id])
  varietyId           String?
  variety             CropVariety?      @relation(fields: [varietyId], references: [id])
  hypothesis          String?
  cultivationBlockId  String?
  cultivationBlock    CultivationBlock? @relation(fields: [cultivationBlockId], references: [id])
  startDate           DateTime
  endDate             DateTime?
  methodology         String?
  inputProtocol       String?
  observationSchedule String?
  yieldResult         Float?
  qualityResult       String?
  cost                Decimal?          @db.Decimal(12, 2)
  outcome             TrialOutcome?
  recommendation      String?
  status              String            @default("active")

  observations TrialObservation[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model TrialObservation {
  id               String     @id @default(uuid())
  trialId          String
  trial            RAndDTrial @relation(fields: [trialId], references: [id])
  date             DateTime   @default(now())
  measurementsJson Json?
  photoMediaIds    String[]
  observedById     String
  notes            String?

  createdAt DateTime @default(now())
}

// =========================================================================
// Expenses & petty cash
// =========================================================================

enum FinanceStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

model Expense {
  id                     String        @id @default(uuid())
  farmId                 String
  expenseNumber          String        @unique
  date                   DateTime      @default(now())
  category               String
  department             String?
  vendorId               String?
  vendor                 Vendor?       @relation(fields: [vendorId], references: [id])
  amount                 Decimal       @db.Decimal(12, 2)
  tax                    Decimal?      @db.Decimal(12, 2)
  paymentMethod          String?
  relatedTaskId          String?
  relatedPurchaseOrderId String?
  receiptMediaId         String?
  submittedById          String
  approvedById           String?
  financeStatus          FinanceStatus @default(PENDING)

  pettyCashTransactions PettyCashTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PettyCashTransaction {
  id               String   @id @default(uuid())
  farmId           String
  date             DateTime @default(now())
  type             String // opening | expense | reimbursement | closing
  amount           Decimal  @db.Decimal(12, 2)
  relatedExpenseId String?
  relatedExpense   Expense? @relation(fields: [relatedExpenseId], references: [id])
  balanceAfter     Decimal  @db.Decimal(12, 2)
  recordedById     String
  approvedById     String?

  createdAt DateTime @default(now())
}

// =========================================================================
// Media, communication, meetings
// =========================================================================

model MediaFile {
  id           String    @id @default(uuid())
  farmId       String?
  url          String
  thumbnailUrl String?
  mimeType     String
  sizeBytes    Int?
  uploadedById String
  uploadedAt   DateTime  @default(now())
  entityType   String?
  entityId     String?
  caption      String?
  gpsLat       Float?
  gpsLng       Float?
  capturedAt   DateTime?

  @@index([entityType, entityId])
}

model Comment {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id])
  authorId        String
  body            String
  mentionsUserIds String[]
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
}

model Notification {
  id         String              @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  isRead     Boolean             @default(false)
  channel    NotificationChannel @default(IN_APP)
  createdAt  DateTime            @default(now())

  @@index([userId, isRead])
}

model Approval {
  id            String    @id @default(uuid())
  entityType    String
  entityId      String
  requestedById String
  approverRole  String?
  approverId    String?
  status        String    @default("pending")
  comments      String?
  decidedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

model MeetingRecord {
  id             String   @id @default(uuid())
  farmId         String
  title          String
  date           DateTime @default(now())
  attendeeIds    String[]
  notes          String?
  minutesMediaId String?

  actionItems ActionItem[]

  createdAt DateTime @default(now())
}

model ActionItem {
  id              String         @id @default(uuid())
  meetingRecordId String?
  meetingRecord   MeetingRecord? @relation(fields: [meetingRecordId], references: [id])
  description     String
  assignedToId    String
  dueDate         DateTime?
  status          String         @default("open")
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
}
