// =========================================================================
// Produce distribution & logistics
// =========================================================================

enum RecipientType {
  INTERNAL
  CLIENT
  FRIENDS_FAMILY
  PROCESSING
  EXTERNAL_ORG
  COURIER
  DEPARTMENT
}

model Recipient {
  id          String        @id @default(uuid())
  farmId      String
  name        String
  type        RecipientType
  contactInfo String?

  dispatches Dispatch[]

  createdAt DateTime @default(now())
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Dispatch {
  id               String         @id @default(uuid())
  farmId           String
  dispatchNumber   String         @unique
  recipientId      String
  recipient        Recipient      @relation(fields: [recipientId], references: [id])
  packingDate      DateTime?
  dispatchDate     DateTime       @default(now())
  vehicleOrCourier String?
  destination      String?
  preparedById     String
  approvedById     String?
  deliveryStatus   DeliveryStatus @default(PENDING)
